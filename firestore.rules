rules_version = '2';

// Wszystko, czego tu nie ma, jest zablokowane.
// Lokale wgrywa tylko skrypt `npm run seed` (klucz admina omija te reguły).
// TODO (osoba 3): reguły dla grup i głosów
service cloud.firestore {
  match /databases/{database}/documents {
    match /places/{placeId} {
      allow read: if true;
      allow write: if false;
    }

    // SZKIC (etap 3) – nie deployować przed włączeniem logowania Google.
    // Profil użytkownika: users/{uid} = { name, preferredTags[], favoritePlaceIds[], updatedAt }
    // Czyta i pisze tylko właściciel.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'preferredTags', 'favoritePlaceIds', 'updatedAt'])
        && request.resource.data.get('favoritePlaceIds', []) is list
        && request.resource.data.get('favoritePlaceIds', []).size() <= 100
        && request.resource.data.get('preferredTags', []) is list;
    }
  }
}
